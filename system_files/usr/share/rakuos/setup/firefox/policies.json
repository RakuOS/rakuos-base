{
  "policies": {
    "Homepage": {
      "URL": "https://start.rakuos.org",
      "StartPage": "homepage",
      "Locked": true
    },

    "SearchEngines": {
      "Add": [
        {
          "Name": "RakuOS Web Search",
          "URLTemplate": "https://search.rakuos.org/results?q={searchTerms}",
          "Method": "GET",
          "IconURL": "https://rakuos.org/favicon.ico"
        }
      ],
      "Default": "RakuOS Web Search",
      "PreventInstalls": false
    },

    "DisablePocket": true,
    "DisableTelemetry": true
  }
}
