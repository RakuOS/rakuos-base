{
  "policies": {
    "Homepage": {
      "URL": "https://start.rakuos.org",
      "StartPage": "homepage",
      "Locked": false
    },
    "NewTabPage": {
      "URL": "https://start.rakuos.org",
      "Locked": false
    },
    "OverrideFirstRunPage": "https://start.rakuos.org",
    "OverridePostUpdatePage": "https://start.rakuos.org",
    "SearchEngines": {
      "Add": [
        {
          "Name": "RakuOS Web Search",
          "URLTemplate": "https://search.rakuos.org/results?q={searchTerms}",
          "Method": "GET",
          "IconURL": "https://start.rakuos.org/themes/raku/assets/images/rakuos-logo-sprite.png"
        }
      ],
      "Default": "RakuOS Web Search",
      "PreventInstalls": false
    },

    "DisablePocket": true,
    "DisableTelemetry": true
  }
}
