{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/fastfetch/presets/rakuos/rakuos-ascii.txt",
        "padding": { "top": 2, "left": 1, "right": 4 },
        "color": { "1": "1;38;5;39" }
    },
    "display": {
        "separator": " ",
        "key": { "width": 14 }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{#1;38;5;220}✦ {#1;38;5;39}{user-name}{#38;5;250} @ {#1;38;5;208}{host-name}"
        },
        {
            "type": "custom",
            "format": "{#38;5;220}~~ ★ ~~~~~~~~~~~~~~~~ ★ ~~"
        },
        { "type": "os",       "key": "✹ OS",       "keyColor": "1;38;5;39"  },
        { "type": "kernel",   "key": "◉ KERNEL",   "keyColor": "1;38;5;220" },
        { "type": "uptime",   "key": "➜ UPTIME",   "keyColor": "1;38;5;208" },
        { "type": "packages", "key": "✚ PACKAGES", "keyColor": "1;38;5;196" },
        "break",
        { "type": "shell",    "key": "♪ SHELL",    "keyColor": "1;38;5;76"  },
        { "type": "terminal", "key": "✎ TERMINAL", "keyColor": "1;38;5;141" },
        { "type": "wm",       "key": "✦ WM",       "keyColor": "1;38;5;39"  },
        "break",
        { "type": "cpu",      "key": "✺ CPU",      "keyColor": "1;38;5;220" },
        { "type": "gpu",      "key": "◉ GPU",      "keyColor": "1;38;5;208" },
        { "type": "memory",   "key": "✱ MEMORY",   "keyColor": "1;38;5;196" },
        { "type": "disk",     "key": "◆ DISK",     "keyColor": "1;38;5;76", "showReadOnly": false },
        "break",
        {
            "type": "custom",
            "format": "{#1;38;5;39}~~~~~~~~~ 楽 ~~~~~~~~~"
        },
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
    ]
}
