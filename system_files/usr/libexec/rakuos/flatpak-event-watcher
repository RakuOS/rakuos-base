#!/usr/bin/env bash
set -euo pipefail

SETUP_SCRIPT="/usr/libexec/rakuos/system-flatpak-setup"
BIN_DIR="/var/lib/flatpak/exports/bin"

echo "RakuOS Flatpak event watcher started, watching $BIN_DIR"

# Ensure inotify-tools is installed
command -v inotifywait >/dev/null 2>&1 || {
    echo "Please install inotify-tools"
    exit 1
}

# Initial snapshot of existing scripts
declare -A KNOWN_APPS
for f in "$BIN_DIR"/*; do
    [[ -f "$f" ]] || continue
    [[ "$(basename "$f")" == .* ]] && continue  # ignore dot-files
    KNOWN_APPS["$(basename "$f")"]=1
done

echo "Setting up watches."
# Watch for create/delete events
inotifywait -m -e create -e delete --format '%e %f' "$BIN_DIR" | while read -r event file; do

    # Ignore hidden files (temporary symlinks)
    [[ "$file" == .* ]] && continue

    case "$event" in
        CREATE*)
            APPID="$file"
            # Skip if we already know about it
            [[ -n "${KNOWN_APPS[$APPID]:-}" ]] && continue
            echo "Detected Flatpak install for $APPID"
            "$SETUP_SCRIPT" watcher "$APPID" install
            KNOWN_APPS["$APPID"]=1
            ;;
        DELETE*)
            APPID="$file"
            # Only run uninstall if we knew about it
            [[ -z "${KNOWN_APPS[$APPID]:-}" ]] && continue
            echo "Detected Flatpak uninstall for $APPID"
            "$SETUP_SCRIPT" watcher "$APPID" uninstall
            unset KNOWN_APPS["$APPID"]
            ;;
        *)
            # Ignore other events
            ;;
    esac

done