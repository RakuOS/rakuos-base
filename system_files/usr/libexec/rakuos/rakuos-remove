#!/usr/bin/env bash
set -euo pipefail

INSTALLROOT="/var/lib/rakuos/packages"
PACKAGES_LIST="/var/lib/rakuos/packages.list"
DIRTY_FILE="/var/lib/rakuos/overlay.dirty"

PACKAGES=("${@}")

if [[ "${#PACKAGES[@]}" -eq 0 ]]; then
    echo "Usage: rakuos remove <package> [package2] [package3]..."
    exit 1
fi

if [[ "$EUID" -ne 0 ]]; then
    echo "ERROR: rakuos remove must be run as root"
    exit 1
fi

FEDORA_VER=$(. /etc/os-release && echo "$VERSION_ID")

_dnf() {
    dnf5.real --installroot "$INSTALLROOT" \
              --setopt=reposdir=/etc/yum.repos.d \
              --releasever "$FEDORA_VER" \
              --setopt=best=False \
              "$@"
}

# Filter: only remove packages tracked in packages.list
TO_REMOVE=()
for pkg in "${PACKAGES[@]}"; do
    if ! grep -qx "$pkg" "$PACKAGES_LIST" 2>/dev/null; then
        echo "$pkg is not in the RakuOS package list — skipping."
    else
        TO_REMOVE+=("$pkg")
    fi
done

if [[ "${#TO_REMOVE[@]}" -eq 0 ]]; then
    echo "None of the requested packages are in the RakuOS package list."
    exit 0
fi

echo "Removing ${TO_REMOVE[*]}..."

_dnf remove -y "${TO_REMOVE[@]}" \
    || echo "Warning: dnf5 remove returned non-zero, may already be gone."

# Post-removal integration
ldconfig
if [[ -d "$INSTALLROOT/usr/share/applications" ]]; then
    update-desktop-database "$INSTALLROOT/usr/share/applications" 2>/dev/null || true
fi

# Remove each from packages.list
for pkg in "${TO_REMOVE[@]}"; do
    sed -i "/^${pkg}$/d" "$PACKAGES_LIST"
done

touch "$DIRTY_FILE"
echo "${TO_REMOVE[*]} removed from RakuOS package list."
