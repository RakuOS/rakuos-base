#!/usr/bin/env bash
set -euo pipefail

DKMS_BASE="/var/lib/dkms/nvidia"
SRC_BASE="/usr/src"

# Get installed NVIDIA version from RPM (authoritative)
NVIDIA_VER=$(rpm -q --queryformat '%{VERSION}\n' dkms-nvidia 2>/dev/null || true)

if [ -z "${NVIDIA_VER:-}" ]; then
    echo "dkms-nvidia not installed, skipping"
    exit 0
fi

SRC_PATH="$SRC_BASE/nvidia-$NVIDIA_VER"
TARGET_DIR="$DKMS_BASE/$NVIDIA_VER"

echo "Ensuring DKMS state for NVIDIA $NVIDIA_VER"

# If source doesn't exist, bail (image is broken or mismatch)
if [ ! -d "$SRC_PATH" ]; then
    echo "Missing source: $SRC_PATH"
    exit 1
fi

# Ensure base dir exists
mkdir -p "$DKMS_BASE"

# 🔥 Remove ALL other versions (authoritative reset)
for dir in "$DKMS_BASE"/*; do
    [ -d "$dir" ] || continue

    if [ "$(basename "$dir")" != "$NVIDIA_VER" ]; then
        echo "Removing stale DKMS version: $dir"
        rm -rf "$dir"
    fi
done

# Recreate correct structure
mkdir -p "$TARGET_DIR"

# 🔗 Fix symlink
ln -sfn "$SRC_PATH" "$TARGET_DIR/source"

echo "Linked: $TARGET_DIR/source -> $SRC_PATH"