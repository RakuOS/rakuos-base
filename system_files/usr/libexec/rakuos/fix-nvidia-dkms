#!/usr/bin/env bash
set -euo pipefail

DKMS_DIR="/var/lib/dkms/nvidia"
SRC_BASE="/usr/src"

# Detect currently installed NVIDIA version from /usr/src
current_src=$(ls -d "$SRC_BASE"/nvidia-* 2>/dev/null | sort -V | tail -n1 || true)

if [ -z "${current_src:-}" ]; then
    echo "No NVIDIA source found in /usr/src"
    exit 0
fi

current_version=$(basename "$current_src" | sed 's/^nvidia-//')
target_dir="$DKMS_DIR/$current_version"

echo "Current NVIDIA version: $current_version"

# Ensure DKMS base dir exists
mkdir -p "$DKMS_DIR"

# 🔥 Remove ALL old versions
for dir in "$DKMS_DIR"/*; do
    [ -d "$dir" ] || continue

    if [ "$(basename "$dir")" != "$current_version" ]; then
        echo "Removing old DKMS entry: $dir"
        rm -rf "$dir"
    fi
done

# ✅ Recreate correct structure
mkdir -p "$target_dir"

# 🔗 Fix symlink (force overwrite)
ln -sfn "$current_src" "$target_dir/source"

echo "Symlink set: $target_dir/source -> $current_src"