#!/usr/bin/env bash
set -euo pipefail

echo "Starting RakuOS Auto Updater (rpm-ostree)..."

# -------------------------------
# Detect currently running GHCR image
# -------------------------------
STATUS_JSON=$(rpm-ostree status --json)

# Try to get the base from active deployment
CURRENT_IMAGE=$(echo "$STATUS_JSON" | jq -r '.deployments[] | select(.booted==true) | .base // empty')

# Fallback: use the first deployment base if booted not set
if [[ -z "$CURRENT_IMAGE" ]]; then
    CURRENT_IMAGE=$(echo "$STATUS_JSON" | jq -r '.deployments[0].base // empty')
fi

# Fallback again: if still empty, mark as unknown
if [[ -z "$CURRENT_IMAGE" ]]; then
    echo "Could not detect current image base!"
    CURRENT_IMAGE="unknown"
fi

# Parse repo/tag
REPO_URL="${CURRENT_IMAGE#ostree-unverified-registry:}"   # strip prefix
CURRENT_TAG="${REPO_URL##*:}"                              # latest, 20260306, etc
REPO_URL="${REPO_URL%:*}"                                  # ghcr.io/rakuos/rakuos-kde

LOCAL_DIGEST=$(echo "$STATUS_JSON" | jq -r '.deployments[] | select(.booted==true) | .checksum // empty')
if [[ -z "$LOCAL_DIGEST" ]]; then
    LOCAL_DIGEST=$(echo "$STATUS_JSON" | jq -r '.deployments[0].checksum // empty')
fi

echo "Current image repo: $REPO_URL"
echo "Current tag: $CURRENT_TAG"
echo "Current digest: $LOCAL_DIGEST"

# -------------------------------
# Get GHCR token
# -------------------------------
REPO_PATH="${REPO_URL#ghcr.io/}"   # e.g., rakuos/rakuos-kde

if [[ "$REPO_PATH" == "unknown" ]]; then
    echo "Skipping GHCR check — unknown repo"
    NEWEST_TAG="$CURRENT_TAG"
    REMOTE_DIGEST="$LOCAL_DIGEST"
else
    TOKEN=$(curl -fsSL "https://ghcr.io/token?scope=repository:$REPO_PATH:pull&service=ghcr.io" | jq -r .token)
    if [[ -z "$TOKEN" || "$TOKEN" == "null" ]]; then
        echo "Failed to get GHCR token for $REPO_PATH"
        exit 1
    fi

    # -------------------------------
    # Get latest dated tag from GHCR
    # -------------------------------
    TAGS_JSON=$(curl -fsSL -H "Authorization: Bearer $TOKEN" "https://ghcr.io/v2/$REPO_PATH/tags/list")
    if ! echo "$TAGS_JSON" | jq -e .tags >/dev/null 2>&1; then
        echo "Error fetching tags from GHCR. Response:"
        echo "$TAGS_JSON"
        exit 1
    fi

    NEWEST_TAG=$(echo "$TAGS_JSON" | jq -r '.tags[]' | grep -E '^[0-9]{8}$' | sort | tail -n1)
    echo "Latest dated tag on GHCR: $NEWEST_TAG"

    # -------------------------------
    # Get remote digest for newest tag
    # -------------------------------
    REMOTE_DIGEST=$(curl -fsSL \
      -H "Authorization: Bearer $TOKEN" \
      -H "Accept: application/vnd.oci.image.manifest.v1+json" \
      "https://ghcr.io/v2/$REPO_PATH/manifests/$NEWEST_TAG" \
      | jq -r '.config.digest')

    if [[ -z "$REMOTE_DIGEST" || "$REMOTE_DIGEST" == "null" ]]; then
        echo "Failed to get remote digest for $NEWEST_TAG"
        exit 1
    fi
    echo "Remote digest: $REMOTE_DIGEST"
fi

# -------------------------------
# Compare and rebase if needed
# -------------------------------
if [[ "$LOCAL_DIGEST" != "$REMOTE_DIGEST" ]]; then
    echo "New image detected — rebasing to $NEWEST_TAG"

    BEFORE_COUNT=$(echo "$STATUS_JSON" | jq '.deployments | length')
    echo "Deployments before rebase: $BEFORE_COUNT"

    rpm-ostree rebase "ostree-unverified-registry:$REPO_URL:$NEWEST_TAG"

    echo "Upgrading layered packages..."
    rpm-ostree upgrade --allow-inactive

    AFTER_COUNT=$(rpm-ostree status --json | jq '.deployments | length')
    echo "Deployments after rebase: $AFTER_COUNT"

    if [[ "$AFTER_COUNT" -gt "$BEFORE_COUNT" ]]; then
        echo "New deployment applied — sending notification."

        ACTIVE_USER=$(loginctl list-sessions --no-legend | awk '{print $3}' | head -n1)

        if [[ -n "$ACTIVE_USER" ]] && command -v notify-send &>/dev/null; then
            USER_UID=$(id -u "$ACTIVE_USER")
            USER_RUNTIME="/run/user/$USER_UID"

            echo "Sending notification to user: $ACTIVE_USER"

            ACTION=$(sudo -u "$ACTIVE_USER" \
                DBUS_SESSION_BUS_ADDRESS="unix:path=$USER_RUNTIME/bus" \
                DISPLAY=:0 \
                notify-send \
                --app-name="RakuOS Updater" \
                --icon=system-software-update \
                --urgency=normal \
                --expire-time=0 \
                --action=reboot="Reboot Now" \
                --action=later="Later" \
                --wait \
                "RakuOS Updates Available" \
                "A new system image is available. Choose an action:")

            case "$ACTION" in
                reboot)
                    echo "User chose reboot"
                    systemctl reboot
                    ;;
                *)
                    echo "User chose later or dismissed"
                    ;;
            esac
        else
            echo "No active graphical session — skipping notification."
        fi
    else
        echo "Rebase completed but no new deployment detected."
    fi

else
    echo "System already running latest image — upgrading layered packages if any."
    rpm-ostree upgrade --allow-inactive
fi

echo "RakuOS Auto Updater finished."