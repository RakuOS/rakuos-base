#!/usr/bin/env bash
set -euo pipefail

echo "Starting RakuOS Auto Updater (rpm-ostree)..."

# -------------------------------
# Detect currently running GHCR image
# -------------------------------
STATUS_JSON=$(rpm-ostree status --json)

# Parse repo and current tag from the booted deployment line
CURRENT_LINE=$(rpm-ostree status | grep -E '^\s*●' | sed 's/.*●\s*//' | tr -d '[:space:]')
CURRENT_LINE="${CURRENT_LINE#ostree-unverified-registry:}"

REPO_URL="${CURRENT_LINE%:*}"      # e.g. ghcr.io/rakuos/rakuos-kde
CURRENT_TAG="${CURRENT_LINE##*:}"  # e.g. 20260306 or latest

# Sanitize — strip any stray whitespace or newlines
REPO_URL="$(echo "$REPO_URL" | tr -d '[:space:]')"
CURRENT_TAG="$(echo "$CURRENT_TAG" | tr -d '[:space:]')"

echo "Current image repo: $REPO_URL"
echo "Current tag:        $CURRENT_TAG"

# -------------------------------
# Get GHCR token
# -------------------------------
REPO_PATH="${REPO_URL#ghcr.io/}"   # e.g. rakuos/rakuos-kde

if [[ "$REPO_PATH" == "$REPO_URL" ]]; then
    echo "ERROR: Could not parse GHCR repo path from: $REPO_URL"
    exit 1
fi

TOKEN=$(curl -fsSL \
    "https://ghcr.io/token?scope=repository:${REPO_PATH}:pull&service=ghcr.io" \
    | jq -r .token)

if [[ -z "$TOKEN" || "$TOKEN" == "null" ]]; then
    echo "ERROR: Failed to get GHCR token for $REPO_PATH"
    exit 1
fi

# -------------------------------
# Get newest tag from org.opencontainers.image.version annotation on 'latest'
# Workflow sets this to: latest.YYYYMMDD — strip 'latest.' to get the date
# -------------------------------
LATEST_MANIFEST=$(curl -fsSL \
    -H "Authorization: Bearer $TOKEN" \
    -H "Accept: application/vnd.oci.image.manifest.v1+json" \
    "https://ghcr.io/v2/$REPO_PATH/manifests/latest")

# Try manifest-level annotations first
VERSION_ANNOTATION=$(echo "$LATEST_MANIFEST" \
    | jq -r '.annotations["org.opencontainers.image.version"] // empty')

# Fallback: check config blob labels
if [[ -z "$VERSION_ANNOTATION" ]]; then
    CONFIG_DIGEST=$(echo "$LATEST_MANIFEST" | jq -r '.config.digest // empty')
    if [[ -n "$CONFIG_DIGEST" ]]; then
        VERSION_ANNOTATION=$(curl -fsSL \
            -H "Authorization: Bearer $TOKEN" \
            "https://ghcr.io/v2/$REPO_PATH/blobs/$CONFIG_DIGEST" \
            | jq -r '.config.Labels["org.opencontainers.image.version"] // empty')
    fi
fi

# Extract YYYYMMDD from value like "latest.20260306"
NEWEST_TAG=$(echo "$VERSION_ANNOTATION" | sed 's/^latest\.//' | grep -oE '^[0-9]{8}$' || true)

if [[ -z "$NEWEST_TAG" ]]; then
    echo "ERROR: Could not extract date from latest manifest annotation."
    echo "Version annotation value: '$VERSION_ANNOTATION'"
    echo "Manifest response:"
    echo "$LATEST_MANIFEST" | jq . || echo "$LATEST_MANIFEST"
    exit 1
fi
    echo "Latest dated tag on GHCR: $NEWEST_TAG"
    
# -------------------------------
# Compare tags — skip if already on newest
# -------------------------------
if echo "$CURRENT_TAG" | grep -qE '^[0-9]{8}$'; then
    if [[ "$CURRENT_TAG" -ge "$NEWEST_TAG" ]]; then
        echo "Already on latest image ($CURRENT_TAG) — upgrading layered packages only."
        rpm-ostree upgrade
        echo "RakuOS Auto Updater finished."
        exit 0
    fi
else
    echo "Current tag is '$CURRENT_TAG' (non-date), will rebase to dated tag $NEWEST_TAG."
fi

# -------------------------------
# Rebase to newest dated tag
# -------------------------------
echo "New image available: $NEWEST_TAG (current: $CURRENT_TAG) — rebasing..."

BEFORE_COUNT=$(echo "$STATUS_JSON" | jq '.deployments | length')

rpm-ostree rebase "ostree-unverified-registry:$REPO_URL:$NEWEST_TAG"

echo "Upgrading layered packages..."
rpm-ostree upgrade

AFTER_JSON=$(rpm-ostree status --json)
AFTER_COUNT=$(echo "$AFTER_JSON" | jq '.deployments | length')

echo "Deployments before: $BEFORE_COUNT — after: $AFTER_COUNT"

if [[ "$AFTER_COUNT" -gt "$BEFORE_COUNT" ]]; then
    echo "New deployment staged — notifying user."

    ACTIVE_USER=$(loginctl list-sessions --no-legend | awk '{print $3}' | head -n1)

    if [[ -n "$ACTIVE_USER" ]] && command -v notify-send &>/dev/null; then
        USER_UID=$(id -u "$ACTIVE_USER")
        USER_RUNTIME="/run/user/$USER_UID"

        echo "Sending notification to: $ACTIVE_USER"

        ACTION=$(sudo -u "$ACTIVE_USER" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$USER_RUNTIME/bus" \
            DISPLAY=:0 \
            notify-send \
            --app-name="RakuOS Updater" \
            --icon=system-software-update \
            --urgency=normal \
            --expire-time=0 \
            --action=reboot="Reboot Now" \
            --action=later="Later" \
            --wait \
            "RakuOS Update Ready" \
            "Image $NEWEST_TAG is staged. Reboot to apply." 2>/dev/null || echo "later")

        case "$ACTION" in
            reboot)
                echo "User chose reboot — rebooting now."
                systemctl reboot
                ;;
            *)
                echo "User chose later or dismissed."
                ;;
        esac
    else
        echo "No active graphical session — skipping notification."
    fi
else
    echo "Rebase ran but no new deployment detected — may already be current."
fi

echo "RakuOS Auto Updater finished."