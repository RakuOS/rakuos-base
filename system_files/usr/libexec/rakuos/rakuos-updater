#!/usr/bin/env bash
set -euo pipefail

CONFIG_PATH="/etc/topgrade/topgrade.toml"

echo "Starting RakuOS Auto Updater (rpm-ostree)..."

# Run Topgrade with minimal rpm-ostree config
topgrade --config "$CONFIG_PATH" --only "system" --yes --allow-root --skip-notify

echo "Updates applied."

# -------------------------------
# Persistent notification with buttons
# -------------------------------
if command -v gdbus &>/dev/null; then
    APP_NAME="RakuOS Updater"
    ICON="system-software-update"

    # Send notification with proper action-id/label pairs
    # Format: ['action-id','Label','action-id','Label']
    RESPONSE=$(gdbus call --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        "$APP_NAME" \
        0 \
        "$ICON" \
        "RakuOS Updates Complete" \
        "System updates have been applied. Choose an action:" \
        "['reboot','Reboot Now','later','Later']" \
        "{}" \
        -1)

    # Extract notification ID
    NOTIF_ID=$(echo "$RESPONSE" | awk -F'[(), ]+' '{print $2}')

    echo "Notification sent (ID: $NOTIF_ID)"

    # Listen for user action
    gdbus monitor --session --dest org.freedesktop.Notifications | while read -r line; do
        if [[ "$line" == *"ActionInvoked"* && "$line" == *"$NOTIF_ID"* ]]; then
            if [[ "$line" == *"reboot"* ]]; then
                echo "User chose reboot."
                systemctl reboot
                break
            elif [[ "$line" == *"later"* ]]; then
                echo "User chose later."
                # Explicitly close notification
                gdbus call --session \
                    --dest org.freedesktop.Notifications \
                    --object-path /org/freedesktop/Notifications \
                    --method org.freedesktop.Notifications.CloseNotification \
                    "$NOTIF_ID" >/dev/null
                break
            fi
        fi
    done
else
    echo "Updates complete. Please reboot at your convenience."
fi

echo "RakuOS Auto Updater finished."