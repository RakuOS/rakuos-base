#!/usr/bin/env bash
# rakuos-update — RakuOS package update manager.
# Handles check and upgrade of user packages in the installroot and their dependencies.
#
# Usage:
#   rakuos-update check           — print available updates as JSON, exit 0=updates 1=none
#   rakuos-update upgrade         — perform the upgrade
#   rakuos-update check-flatpak   — print available flatpak updates as JSON
#   rakuos-update upgrade-flatpak — upgrade all flatpak apps and runtimes
#   rakuos-update check-image     — check bootc for a new system image (JSON)
#   rakuos-update upgrade-image   — run bootc update

set -euo pipefail

INSTALLROOT="/var/lib/rakuos/packages"
PACKAGES_LIST="/var/lib/rakuos/packages.list"
PKG_CACHE_DIR="/var/lib/rakuos/pkgcache"
COMMAND="${1:-upgrade}"
FEDORA_VER=$(. /etc/os-release && echo "$VERSION_ID")

# ── Helpers ───────────────────────────────────────────────────────────────────

die() { echo "ERROR: $*" >&2; exit 1; }

dnf() {
    dnf5.real --installroot "$INSTALLROOT" \
              --setopt=reposdir=/etc/yum.repos.d \
              --releasever "$FEDORA_VER" \
              --setopt=best=False \
              --setopt=keepcache=True \
              --setopt=cachedir="$PKG_CACHE_DIR" \
              "$@"
}

# ── Fix hardcoded /usr/ paths in installroot .desktop files ──────────────────
_fix_desktop_exec_paths() {
    local app_dir="$INSTALLROOT/usr/share/applications"
    [[ -d "$app_dir" ]] || return 0
    local count=0
    local tmpfile
    while IFS= read -r -d '' desktop; do
        local changed=false
        tmpfile=$(mktemp)
        while IFS= read -r line; do
            if [[ "$line" =~ ^(Exec=|TryExec=)(.*) ]]; then
                local key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
                local mods=""
                if [[ "$val" =~ ^([-@!+]+)(.*) ]]; then
                    mods="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
                fi
                local first_token="${val%% *}"
                if [[ "$first_token" == /usr/* ]]; then
                    local ir_bin="${INSTALLROOT}${first_token}"
                    if [[ -f "$ir_bin" || -L "$ir_bin" ]]; then
                        local rest="${val#"$first_token"}"
                        line="${key}${mods}${INSTALLROOT}${first_token}${rest}"
                        changed=true
                    fi
                fi
            fi
            printf '%s\n' "$line"
        done < "$desktop" > "$tmpfile"
        if [[ "$changed" == "true" ]]; then
            mv "$tmpfile" "$desktop"
            (( count++ )) || true
        else
            rm -f "$tmpfile"
        fi
    done < <(find "$app_dir" -name "*.desktop" -print0 2>/dev/null)
    [[ $count -gt 0 ]] && echo "RakuOS: fixed Exec= paths in $count desktop file(s)."
    return 0
}

require_packages_list() {
    [[ -f "$PACKAGES_LIST" ]] || die "No packages.list found at $PACKAGES_LIST"
    [[ -s "$PACKAGES_LIST" ]] || { echo "No packages installed."; exit 0; }
}

get_user_packages() {
    sort -u "$PACKAGES_LIST"
}

# Get full recursive dep tree of user packages that are installed in the installroot
get_overlay_deps() {
    local user_pkgs
    user_pkgs=$(get_user_packages)
    [[ -z "$user_pkgs" ]] && return

    local pkg_csv
    pkg_csv=$(echo "$user_pkgs" | paste -sd ',')

    dnf repoquery --installed \
        --whatrequires "$pkg_csv" \
        --recursive \
        --queryformat '%{name}\n' 2>/dev/null \
        | sort -u || true
}

get_overlay_packages() {
    local user deps
    user=$(get_user_packages)
    deps=$(get_overlay_deps)
    echo -e "$user\n$deps" | sort -u | grep -v '^$'
}

# Detect if a package owns a .desktop file (GUI app)
is_gui_package() {
    rpm --root "$INSTALLROOT" -ql "$1" 2>/dev/null | grep -q '\.desktop$' && return 0
    compgen -G "$INSTALLROOT/usr/share/applications/${1}*.desktop" >/dev/null 2>&1 && return 0
    dnf repoquery --list "$1" 2>/dev/null | grep -q '\.desktop$'
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_check() {
    require_packages_list

    echo "RakuOS: checking for package updates..." >&2
    local overlay_pkgs
    overlay_pkgs=$(get_overlay_packages)

    if [[ -z "$overlay_pkgs" ]]; then
        echo '{"updates": []}'
        exit 1
    fi

    local -a pkg_array
    mapfile -t pkg_array <<< "$overlay_pkgs"

    local check_output exit_code
    check_output=$(dnf check-update --quiet "${pkg_array[@]}" 2>/dev/null) || exit_code=$?
    exit_code=${exit_code:-0}

    if [[ $exit_code -eq 100 ]]; then
        local json='{"updates": ['
        local first=1
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            [[ "$line" =~ ^[[:space:]] ]] && continue
            [[ "$line" =~ ^Last ]] && continue
            [[ "$line" =~ ^Obsoleting ]] && continue
            local name_arch version repo name gui current_version
            name_arch=$(echo "$line" | awk '{print $1}')
            version=$(echo "$line"   | awk '{print $2}')
            repo=$(echo "$line"      | awk '{print $3}')
            name=$(echo "$name_arch" | sed 's/\.[a-z_0-9]*$//')
            [[ -z "$name" || -z "$version" ]] && continue
            current_version=$(rpm --root "$INSTALLROOT" -q --qf '%{VERSION}-%{RELEASE}' "$name" 2>/dev/null || echo "")
            gui="false"
            is_gui_package "$name" && gui="true"
            [[ $first -eq 0 ]] && json+=","
            json+="{\"name\":\"$name\",\"version\":\"$version\",\"current_version\":\"$current_version\",\"repo\":\"$repo\",\"gui\":$gui}"
            first=0
        done <<< "$check_output"
        json+="]}"
        echo "$json"
        exit 0
    else
        echo '{"updates": []}'
        exit 1
    fi
}

cmd_upgrade() {
    require_packages_list

    echo "RakuOS: upgrading packages..."
    local overlay_pkgs
    overlay_pkgs=$(get_overlay_packages)

    if [[ -z "$overlay_pkgs" ]]; then
        echo "RakuOS: no packages to upgrade."
        exit 0
    fi

    local -a pkg_array
    mapfile -t pkg_array <<< "$overlay_pkgs"

    dnf upgrade -y --refresh "${pkg_array[@]}"

    # Update integration after upgrade
    ldconfig
    systemctl daemon-reload 2>/dev/null || true
    if [[ -d "$INSTALLROOT/usr/share/applications" ]]; then
        _fix_desktop_exec_paths
        update-desktop-database "$INSTALLROOT/usr/share/applications" 2>/dev/null || true
    fi

    echo "RakuOS: package upgrade complete."
}

cmd_check_flatpak() {
    echo "RakuOS: checking for Flatpak updates..." >&2
    flatpak update --appstream -y &>/dev/null || true

    local app_updates runtime_updates
    app_updates=$(flatpak remote-ls --updates --app \
        --columns=name,application,version 2>/dev/null) || true
    runtime_updates=$(flatpak remote-ls --updates --runtime \
        --columns=name,application,version 2>/dev/null) || true

    if [[ -z "$app_updates" && -z "$runtime_updates" ]]; then
        echo '{"updates": []}'
        exit 1
    fi

    local json='{"updates": ['
    local first=1

    while IFS=$'\t' read -r name app_id version; do
        [[ -z "$app_id" ]] && continue
        name="${name//\"/\\\"}"
        current_version=$(flatpak info "$app_id" 2>/dev/null | awk '/Version:/{print $2}')
        [[ $first -eq 0 ]] && json+=","
        json+="{\"name\":\"$name\",\"app_id\":\"$app_id\",\"version\":\"$version\",\"current_version\":\"$current_version\",\"runtime\":false}"
        first=0
    done <<< "$app_updates"

    while IFS=$'\t' read -r name app_id version; do
        [[ -z "$app_id" ]] && continue
        name="${name//\"/\\\"}"
        current_version=$(flatpak info "$app_id" 2>/dev/null | awk '/Version:/{print $2}')
        [[ $first -eq 0 ]] && json+=","
        json+="{\"name\":\"$name\",\"app_id\":\"$app_id\",\"version\":\"$version\",\"current_version\":\"$current_version\",\"runtime\":true}"
        first=0
    done <<< "$runtime_updates"

    json+="]}"
    echo "$json"
    exit 0
}

cmd_upgrade_flatpak() {
    echo "RakuOS: upgrading Flatpak packages..."
    flatpak update -y
    echo "RakuOS: Flatpak upgrade complete."
}

_ghcr_get_image_info() {
    # Populates globals: IMAGE_FULL REPO_URL REPO_PATH CURRENT_TAG TOKEN NEWEST_TAG
    local bootc_status
    bootc_status=$(sudo bootc status --json 2>/dev/null) || die "bootc status failed"

    IMAGE_FULL=$(echo "$bootc_status" \
        | jq -r '.status.booted.image.image.image // empty' | tr -d '[:space:]')
    REPO_URL="${IMAGE_FULL%:*}"
    REPO_PATH="${REPO_URL#ghcr.io/}"
    CURRENT_TAG=$(echo "$bootc_status" \
        | jq -r '.status.booted.image.version // empty' \
        | sed 's/^latest\.//' | tr -d '[:space:]')

    [[ -n "$REPO_URL" ]]    || die "Could not detect booted image from bootc status."
    [[ -n "$CURRENT_TAG" ]] || die "Could not detect current tag from bootc status."
    [[ "$REPO_PATH" != "$REPO_URL" ]] \
        || die "Could not parse GHCR repo path from: $REPO_URL"

    TOKEN=$(curl -fsSL \
        "https://ghcr.io/token?scope=repository:${REPO_PATH}:pull&service=ghcr.io" \
        | jq -r .token)
    [[ -n "$TOKEN" && "$TOKEN" != "null" ]] \
        || die "Failed to get GHCR token for $REPO_PATH"

    local latest_manifest version_annotation config_digest
    latest_manifest=$(curl -fsSL \
        -H "Authorization: Bearer $TOKEN" \
        -H "Accept: application/vnd.oci.image.manifest.v1+json" \
        "https://ghcr.io/v2/$REPO_PATH/manifests/latest")

    version_annotation=$(echo "$latest_manifest" \
        | jq -r '.annotations["org.opencontainers.image.version"] // empty')

    if [[ -z "$version_annotation" ]]; then
        config_digest=$(echo "$latest_manifest" | jq -r '.config.digest // empty')
        if [[ -n "$config_digest" ]]; then
            version_annotation=$(curl -fsSL \
                -H "Authorization: Bearer $TOKEN" \
                "https://ghcr.io/v2/$REPO_PATH/blobs/$config_digest" \
                | jq -r '.config.Labels["org.opencontainers.image.version"] // empty')
        fi
    fi

    NEWEST_TAG=$(echo "$version_annotation" \
        | sed 's/^latest\.//' | grep -oE '^[0-9]{8}$' || true)
    [[ -n "$NEWEST_TAG" ]] \
        || die "Could not extract date tag from GHCR manifest. Got: '$version_annotation'"
}

cmd_check_image() {
    echo "RakuOS: checking for system image update..." >&2

    local IMAGE_FULL REPO_URL REPO_PATH CURRENT_TAG TOKEN NEWEST_TAG
    _ghcr_get_image_info

    echo "Current tag: $CURRENT_TAG" >&2
    echo "Latest tag:  $NEWEST_TAG"  >&2

    if echo "$CURRENT_TAG" | grep -qE '^[0-9]{8}$'; then
        if [[ "$NEWEST_TAG" -gt "$CURRENT_TAG" ]]; then
            echo "{\"update\":true,\"type\":\"switch\",\"booted\":\"$CURRENT_TAG\",\"available\":\"$NEWEST_TAG\",\"repo\":\"$REPO_URL\"}"
            exit 0
        fi
    fi

    echo "RakuOS: same tag, checking for content updates..." >&2
    local check_out
    check_out=$(sudo bootc upgrade --check 2>&1) || true

    if echo "$check_out" | grep -q "No changes"; then
        echo "{\"update\":false,\"booted\":\"$CURRENT_TAG\",\"available\":\"$CURRENT_TAG\"}"
        exit 1
    fi

    echo "{\"update\":true,\"type\":\"upgrade\",\"booted\":\"$CURRENT_TAG\",\"available\":\"$CURRENT_TAG\",\"repo\":\"$REPO_URL\"}"
    exit 0
}

cmd_upgrade_image() {
    echo "RakuOS: checking for system image update..."

    local IMAGE_FULL REPO_URL REPO_PATH CURRENT_TAG TOKEN NEWEST_TAG
    _ghcr_get_image_info

    if echo "$CURRENT_TAG" | grep -qE '^[0-9]{8}$' \
        && [[ "$NEWEST_TAG" -gt "$CURRENT_TAG" ]]; then
        echo "RakuOS: switching to new image tag $REPO_URL:$NEWEST_TAG..."
        bootc switch "$REPO_URL:$NEWEST_TAG"
        echo "RakuOS: system image update staged. Reboot to apply."
        exit 0
    fi

    echo "RakuOS: upgrading current image tag $CURRENT_TAG..."
    bootc upgrade
    echo "RakuOS: system image update staged. Reboot to apply."
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

case "$COMMAND" in
    check)           cmd_check ;;
    upgrade)         cmd_upgrade ;;
    check-flatpak)   cmd_check_flatpak ;;
    upgrade-flatpak) cmd_upgrade_flatpak ;;
    check-image)     cmd_check_image ;;
    upgrade-image)   cmd_upgrade_image ;;
    *) die "Unknown command: $COMMAND. Use check|upgrade|check-flatpak|upgrade-flatpak|check-image|upgrade-image" ;;
esac
