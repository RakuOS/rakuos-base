#!/bin/bash
# rakuos-webapp-launcher — Launch a web app using the bundled CEF cefsimple.
#
# Usage: rakuos-webapp-launcher <url> <n> [custom_css]
#
# CEF binaries live at /usr/lib/rakuos-cef/
# Per-app user data isolated at ~/.local/share/rakuos/webapps/cef-data/<id>

CEF_DIR="/usr/lib/rakuos-cef"
CEFSIMPLE="${CEF_DIR}/cefsimple"

if [[ ! -x "$CEFSIMPLE" ]]; then
    echo "ERROR: CEF not found at ${CEF_DIR}" >&2
    notify-send "RakuOS Web Apps" "CEF runtime missing. Please reinstall RakuOS." 2>/dev/null || true
    exit 1
fi

URL="${1:?Usage: rakuos-webapp-launcher <url> <n> [custom_css]}"
NAME="${2:?Usage: rakuos-webapp-launcher <url> <n> [custom_css]}"
CUSTOM_CSS="${3:-}"

# Sanitise name to safe id for directory / WM_CLASS
APP_ID="$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')"

# Per-app isolated profile directory — each webapp gets its own cookies/storage
DATA_DIR="${HOME}/.local/share/rakuos/webapps/cef-data/${APP_ID}"
mkdir -p "$DATA_DIR"

# If custom CSS provided, write an injector script into the profile
if [[ -n "$CUSTOM_CSS" ]]; then
    INJECT_DIR="${DATA_DIR}/injections"
    mkdir -p "$INJECT_DIR"
    cat > "${INJECT_DIR}/custom.css" << CSSEOF
${CUSTOM_CSS}
CSSEOF
fi

export LD_LIBRARY_PATH="${CEF_DIR}:${LD_LIBRARY_PATH:-}"

exec "$CEFSIMPLE" \
    --url="$URL" \
    --user-data-dir="$DATA_DIR" \
    --enable-media-stream \
    --autoplay-policy=no-user-gesture-required \
    --window-name="rakuos-webapp-${APP_ID}" \
    --widevine-cdm-path=/usr/lib/rakuos-cef/WidevineCdm \
    --widevine-cdm-version=$WV_VERSION \
    2>/dev/null