#!/usr/bin/env bash
set -euo pipefail

PACKAGES_LIST="/var/lib/rakuos/packages.list"
UPPER_DIR="/var/lib/rakuos/overlay/upper"
WORK_DIR="/var/lib/rakuos/overlay/work"
STATE_FILE="/var/lib/rakuos/overlay.state"
DIRTY_FILE="/var/lib/rakuos/overlay.dirty"
LOCK_FILE="/run/rakuos-overlay.lock"

IMAGE_PKGS_SAVE="/var/lib/rakuos/image-packages.toml"
OVERLAY_PKGS="/var/lib/rakuos/overlay/upper/lib/sysimage/libdnf5/packages.toml"

# Merge any new [[packages]] entries from the saved image packages.toml into
# the overlay's packages.toml.  Only adds entries missing from the overlay —
# never removes or overwrites existing overlay entries, so user packages are safe.
_merge_packages_toml() {
    [[ -f "$IMAGE_PKGS_SAVE" ]] || { echo "RakuOS overlay sync: no image-packages.toml reference — skipping merge."; return 0; }
    [[ -f "$OVERLAY_PKGS"    ]] || { echo "RakuOS overlay sync: no overlay packages.toml — skipping merge."; return 0; }

    python3 - "$IMAGE_PKGS_SAVE" "$OVERLAY_PKGS" "$PACKAGES_LIST" <<'PYEOF'
import sys
import os

try:
    import tomllib
except ImportError:
    import tomli as tomllib  # Python < 3.11 fallback

image_path   = sys.argv[1]
overlay_path = sys.argv[2]
pkglist_path = sys.argv[3]

with open(image_path, "rb") as f:
    image_data = tomllib.load(f)

with open(overlay_path, "rb") as f:
    overlay_data = tomllib.load(f)

# libdnf5 packages.toml uses [packages.NAME] table format, so tomllib
# gives us {"packages": {"firefox": {"reason": "User"}, ...}}
# Guard against both dict (normal) and list (hypothetical future format).
def _to_dict(raw):
    if isinstance(raw, dict):
        return raw          # {name: {attrs}}
    # [[packages]] array fallback: [{name: .., reason: ..}, ...]
    return {p["name"]: {k: v for k, v in p.items() if k != "name"} for p in raw}

image_pkgs   = _to_dict(image_data.get("packages", {}))
overlay_pkgs = _to_dict(overlay_data.get("packages", {}))

# Load user-requested packages from packages.list
user_pkgs = set()
if os.path.exists(pkglist_path):
    with open(pkglist_path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                user_pkgs.add(line)

# Build merged set:
#   1. All packages from the new image (updated baseline — handles both
#      additions and removals from the image side)
#   2. Overlay-only packages that are in packages.list or have reason="User"
#      in dnf5's tracking — user-installed overlays must survive image changes
merged = dict(image_pkgs)
for name, attrs in overlay_pkgs.items():
    if name not in merged:
        if name in user_pkgs or attrs.get("reason", "").lower() == "user":
            merged[name] = attrs

added   = [n for n in image_pkgs   if n not in overlay_pkgs]
removed = [n for n in overlay_pkgs if n not in merged]

if not added and not removed:
    print("RakuOS overlay sync: packages.toml already up to date — nothing to merge.")
    sys.exit(0)

def _inline_table(attrs):
    # Produce {key = "val", ...} inline TOML table
    parts = []
    for key, val in attrs.items():
        if isinstance(val, str):
            parts.append(f'{key} = "{val}"')
        elif isinstance(val, bool):
            parts.append(f'{key} = {"true" if val else "false"}')
        else:
            parts.append(f'{key} = {val}')
    return "{" + ", ".join(parts) + "}"

with open(overlay_path, "w") as f:
    f.write("[packages]\n")
    for name, attrs in merged.items():
        f.write(f'"{name}" = {_inline_table(attrs)}\n')

print(f"RakuOS overlay sync: packages.toml merged — +{len(added)} added, -{len(removed)} removed.")
PYEOF
}

# Acquire lock so rakuos-base-protect allows our overlay writes
touch "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"' EXIT

# Read packages into array, skip empty lines and comments
mapfile -t PACKAGES < <(
    grep -v '^\s*#' "$PACKAGES_LIST" \
    | grep -v '^\s*$' \
    | sed 's/\s*#.*//' \
    | tr -s ' \t' '\n' \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
    | grep -v '^$'
)

if [[ "${#PACKAGES[@]}" -eq 0 ]]; then
    echo "RakuOS overlay sync: no packages in list — skipping."
    exit 0
fi

# Ensure overlay dirs exist
mkdir -p "$UPPER_DIR" "$WORK_DIR"

# Get current booted image digest
CURRENT_DIGEST=$(bootc status --json | jq -r '.status.booted.image.imageDigest // empty')
if [[ -z "$CURRENT_DIGEST" ]]; then
    echo "WARNING: Could not detect image digest — using unknown."
    CURRENT_DIGEST="unknown"
fi

SAVED_DIGEST=$(cat "$STATE_FILE" 2>/dev/null || echo "")

# Mount overlay if not already mounted
if ! findmnt /usr | grep -q overlay; then
    echo "RakuOS overlay sync: mounting overlay..."
    mount -t overlay overlay \
        -o lowerdir=/usr,upperdir="$UPPER_DIR",workdir="$WORK_DIR" \
        /usr
fi

# ── Determine what needs doing ────────────────────────────────────────────────

OVERLAY_HAS_CONTENT=false
if [[ -n "$(ls -A "$UPPER_DIR" 2>/dev/null)" ]]; then
    OVERLAY_HAS_CONTENT=true
fi

# A missing STATE_FILE means either:
#   - fresh first boot (packages.list just seeded by mount script), or
#   - post-reset (mount script wiped state and re-seeded packages.list)
# Either way: full install needed.
STATE_MISSING=false
if [[ -z "$SAVED_DIGEST" ]]; then
    STATE_MISSING=true
fi

if [[ "$STATE_MISSING" == "true" ]] || [[ "$OVERLAY_HAS_CONTENT" == "false" ]]; then
    echo "RakuOS overlay sync: overlay empty or state missing — performing full install..."
    dnf5.real install -y --config="/usr/share/rakuos/dnf.conf" "${PACKAGES[@]}"
    echo "$CURRENT_DIGEST" > "$STATE_FILE"
    rm -f "$DIRTY_FILE"
    echo "RakuOS overlay sync: full install complete."

elif [[ "$CURRENT_DIGEST" != "$SAVED_DIGEST" ]]; then
    echo "RakuOS overlay sync: image updated — merging packages.toml changes and upgrading overlay packages..."
    _merge_packages_toml
    dnf5.real upgrade -y --config="/usr/share/rakuos/dnf.conf" "${PACKAGES[@]}"
    echo "$CURRENT_DIGEST" > "$STATE_FILE"
    rm -f "$DIRTY_FILE"
    echo "RakuOS overlay sync: upgrade complete."

elif [[ -f "$DIRTY_FILE" ]]; then
    echo "RakuOS overlay sync: package changes detected — syncing..."
    dnf5.real install -y --config="/usr/share/rakuos/dnf.conf" "${PACKAGES[@]}"
    rm -f "$DIRTY_FILE"
    echo "RakuOS overlay sync: sync complete."

else
    echo "RakuOS overlay sync: nothing to do."
fi

# Save digest
echo "$CURRENT_DIGEST" > "$STATE_FILE"

echo "RakuOS overlay sync: done."