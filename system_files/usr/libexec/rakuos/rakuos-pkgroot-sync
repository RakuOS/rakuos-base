#!/usr/bin/env bash
# rakuos-pkgroot-sync — RakuOS package installroot sync.
# Ensures all packages in packages.list are installed into the installroot
# at /var/lib/rakuos/packages, seeding its RPM database from the base image
# so dnf5 does not reinstall base packages.
set -euo pipefail

INSTALLROOT="/var/lib/rakuos/packages"
PACKAGES_LIST="/var/lib/rakuos/packages.list"
PKGROOT_TRACK="/var/lib/rakuos/pkgroot-packages.txt"
PKG_CACHE_DIR="/var/lib/rakuos/pkgcache"
STATE_FILE="/var/lib/rakuos/overlay.state"
DIRTY_FILE="/var/lib/rakuos/overlay.dirty"

FEDORA_VER=$(. /etc/os-release && echo "$VERSION_ID")

_dnf() {
    dnf5.real --installroot "$INSTALLROOT" \
              --setopt=reposdir=/etc/yum.repos.d \
              --releasever "$FEDORA_VER" \
              --setopt=best=False \
              --setopt=keepcache=True \
              --setopt=cachedir="$PKG_CACHE_DIR" \
              "$@"
}

# Seed installroot RPM db from the live image db at /usr/share/rpm.
# Mirrors Fedora's layout: actual db at usr/share/rpm, symlink from
# usr/lib/sysimage/rpm → ../../share/rpm.
_init_installroot() {
    echo "RakuOS sync: seeding installroot RPM database from base image..."
    mkdir -p "$INSTALLROOT/usr/share/rpm"
    cp -a /usr/share/rpm/. "$INSTALLROOT/usr/share/rpm/"
    mkdir -p "$INSTALLROOT/usr/lib/sysimage"
    ln -sfn ../../share/rpm "$INSTALLROOT/usr/lib/sysimage/rpm"
    echo "RakuOS sync: installroot RPM db seeded."
    # Import Terra GPG keys if not already present
    rpm --root "$INSTALLROOT" --import \
        "https://repos.fyralabs.com/terra${FEDORA_VER}/key.asc" 2>/dev/null || true
    rpm --root "$INSTALLROOT" --import \
        "https://repos.fyralabs.com/terra${FEDORA_VER}-mesa/key.asc" 2>/dev/null || true
    rpm --root "$INSTALLROOT" --import \
        "https://repos.fyralabs.com/terra${FEDORA_VER}-multimedia/key.asc" 2>/dev/null || true
}

# On image update: refresh base db records from the new image, then re-register
# user packages from the local RPM cache (no network needed for unchanged pkgs).
# Only packages missing from cache fall back to a dnf download.
_refresh_base_db() {
    echo "RakuOS sync: image updated — merging user packages into refreshed base db..."

    # Step 1: snapshot NEVRA of every user package before wiping the db
    declare -A pkg_nevra
    if [[ -f "$PKGROOT_TRACK" ]] && [[ -s "$PKGROOT_TRACK" ]]; then
        while IFS= read -r pkg; do
            local nevra
            nevra=$(rpm --root "$INSTALLROOT" -q \
                        --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}' \
                        "$pkg" 2>/dev/null) || continue
            [[ -n "$nevra" ]] && pkg_nevra["$pkg"]="$nevra"
        done < "$PKGROOT_TRACK"
    fi

    # Step 2: replace db with current image db (base records now up-to-date)
    rm -rf "$INSTALLROOT/usr/share/rpm"
    mkdir -p "$INSTALLROOT/usr/share/rpm"
    cp -a /usr/share/rpm/. "$INSTALLROOT/usr/share/rpm/"
    mkdir -p "$INSTALLROOT/usr/lib/sysimage"
    ln -sfn ../../share/rpm "$INSTALLROOT/usr/lib/sysimage/rpm"

    # Step 3: re-register each user package from the local RPM cache
    # rpm --justdb -i writes only the db record — no filesystem changes
    local not_cached=()
    for pkg in "${!pkg_nevra[@]}"; do
        local nevra="${pkg_nevra[$pkg]}"
        local cached
        cached=$(find "$PKG_CACHE_DIR" -name "${nevra}.rpm" 2>/dev/null | head -1)
        if [[ -n "$cached" ]]; then
            rpm --root "$INSTALLROOT" --justdb -i "$cached" 2>/dev/null \
                || not_cached+=("$pkg")
        else
            not_cached+=("$pkg")
        fi
    done

    # Rebuild db indexes after batch --justdb inserts
    rpm --root "$INSTALLROOT" --rebuilddb 2>/dev/null || true

    # Step 4: fallback — re-download anything not in cache
    if [[ "${#not_cached[@]}" -gt 0 ]]; then
        echo "RakuOS sync: ${#not_cached[@]} package(s) not in cache — downloading..."
        _dnf install -y --setopt=best=False "${not_cached[@]}"
    fi

    echo "RakuOS sync: base db refreshed, user packages re-registered."
}

# Record every package in the installroot db that isn't in the base image db.
# Covers user-installed packages AND all their pulled-in dependencies.
_update_pkgroot_tracking() {
    mkdir -p /var/lib/rakuos
    comm -23 \
        <(rpm --root "$INSTALLROOT" -qa --qf '%{NAME}\n' 2>/dev/null | sort -u) \
        <(rpm --dbpath /usr/share/rpm  -qa --qf '%{NAME}\n' 2>/dev/null | sort -u) \
        > "$PKGROOT_TRACK" 2>/dev/null || true
}

# Read packages into array, strip comments and blank lines
mapfile -t PACKAGES < <(
    grep -v '^\s*#' "$PACKAGES_LIST" \
    | grep -v '^\s*$' \
    | sed 's/\s*#.*//' \
    | tr -s ' \t' '\n' \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
    | grep -v '^$'
)

if [[ "${#PACKAGES[@]}" -eq 0 ]]; then
    echo "RakuOS sync: no packages in list — skipping."
    exit 0
fi

# Get current booted image digest
CURRENT_DIGEST=$(bootc status --json \
    | jq -r '.status.booted.image.imageDigest // empty' 2>/dev/null || echo "")
if [[ -z "$CURRENT_DIGEST" ]]; then
    echo "WARNING: Could not detect image digest — using unknown."
    CURRENT_DIGEST="unknown"
fi

SAVED_DIGEST=$(cat "$STATE_FILE" 2>/dev/null || echo "")

# Is the installroot RPM db present and non-empty?
# Check the real path (usr/share/rpm); usr/lib/sysimage/rpm is a symlink to it.
INSTALLROOT_READY=false
if [[ -d "$INSTALLROOT/usr/share/rpm" ]] \
    && [[ -n "$(ls -A "$INSTALLROOT/usr/share/rpm" 2>/dev/null)" ]]; then
    INSTALLROOT_READY=true
fi

# ── Determine what needs doing ────────────────────────────────────────────────

if [[ "$INSTALLROOT_READY" == "false" ]] || [[ -z "$SAVED_DIGEST" ]]; then
    # Fresh install or missing state — full init + install
    echo "RakuOS sync: installroot empty or state missing — performing full install..."
    mkdir -p "$INSTALLROOT"
    _init_installroot
    _dnf install -y --setopt=best=False "${PACKAGES[@]}"
    for pkg in "${PACKAGES[@]}"; do
        _dnf mark user "$pkg" 2>/dev/null || true
    done
    _update_pkgroot_tracking
    echo "$CURRENT_DIGEST" > "$STATE_FILE"
    rm -f "$DIRTY_FILE"
    echo "RakuOS sync: full install complete."

elif [[ "$CURRENT_DIGEST" != "$SAVED_DIGEST" ]]; then
    # Image updated — refresh base db and re-register user packages from cache.
    # _refresh_base_db handles the full merge + cache-miss fallback.
    _refresh_base_db
    _update_pkgroot_tracking
    echo "$CURRENT_DIGEST" > "$STATE_FILE"
    rm -f "$DIRTY_FILE"
    echo "RakuOS sync: image update sync complete."

elif [[ -f "$DIRTY_FILE" ]]; then
    # Package list changed — sync
    echo "RakuOS sync: package changes detected — syncing..."
    _dnf install -y --setopt=best=False "${PACKAGES[@]}"
    _update_pkgroot_tracking
    rm -f "$DIRTY_FILE"
    echo "RakuOS sync: sync complete."

else
    echo "RakuOS sync: nothing to do."
fi

# Always write current digest
echo "$CURRENT_DIGEST" > "$STATE_FILE"

# ── Fix hardcoded /usr/ paths in installroot .desktop files ──────────────────
_fix_desktop_exec_paths() {
    local app_dir="$INSTALLROOT/usr/share/applications"
    [[ -d "$app_dir" ]] || return 0
    local count=0
    local tmpfile
    while IFS= read -r -d '' desktop; do
        local changed=false
        tmpfile=$(mktemp)
        while IFS= read -r line; do
            if [[ "$line" =~ ^(Exec=|TryExec=)(.*) ]]; then
                local key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
                local mods=""
                if [[ "$val" =~ ^([-@!+]+)(.*) ]]; then
                    mods="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
                fi
                local first_token="${val%% *}"
                if [[ "$first_token" == /usr/* ]]; then
                    local ir_bin="${INSTALLROOT}${first_token}"
                    if [[ -f "$ir_bin" || -L "$ir_bin" ]]; then
                        local rest="${val#"$first_token"}"
                        line="${key}${mods}${INSTALLROOT}${first_token}${rest}"
                        changed=true
                    fi
                fi
            fi
            printf '%s\n' "$line"
        done < "$desktop" > "$tmpfile"
        if [[ "$changed" == "true" ]]; then
            mv "$tmpfile" "$desktop"
            (( count++ )) || true
        else
            rm -f "$tmpfile"
        fi
    done < <(find "$app_dir" -name "*.desktop" -print0 2>/dev/null)
    [[ $count -gt 0 ]] && echo "RakuOS sync: fixed Exec= paths in $count desktop file(s)."
    return 0
}

# Post-install integration: update linker cache, reload systemd, update desktop db
ldconfig
# Re-run generators so all installroot unit files enter systemd's search path
systemctl daemon-reload 2>/dev/null || true
if [[ -d "$INSTALLROOT/usr/share/applications" ]]; then
    _fix_desktop_exec_paths
    update-desktop-database "$INSTALLROOT/usr/share/applications" 2>/dev/null || true
fi
if [[ -d "$INSTALLROOT/usr/share/icons/hicolor" ]]; then
    gtk-update-icon-cache -f -t "$INSTALLROOT/usr/share/icons/hicolor" 2>/dev/null || true
fi

echo "RakuOS sync: done."
