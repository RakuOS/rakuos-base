gi.require_version("Adw", "1")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Adw, GLib, GdkPixbuf, Gio

WELCOME_DONE_FILE = Path.home() / ".config" / "rakuos" / "welcome-done"
LOGO_DARK  = "/usr/share/pixmaps/fedora_whitelogo_med.png"
LOGO_LIGHT = "/usr/share/pixmaps/fedora_logo_med.png"
ICON_PATH  = "/usr/share/pixmaps/rakuos-logo.png"


def get_logo_path() -> str:
    """Pick logo based on system dark/light mode via Adwaita color scheme."""
    try:
        style_manager = Adw.StyleManager.get_default()
        is_dark = style_manager.get_dark()
    except Exception:
        # Fallback: check GTK theme name
        settings = Gtk.Settings.get_default()
        theme = settings.get_property("gtk-theme-name") or ""
        is_dark = "dark" in theme.lower()
    return LOGO_DARK if is_dark else LOGO_LIGHT


# ─────────────────────────────────────────────
