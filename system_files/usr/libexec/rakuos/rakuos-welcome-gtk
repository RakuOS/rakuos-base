    # ── Setup runner ───────────────────────────

    def _run_setup(self, btn, script, install_btn):
        install_btn.set_sensitive(False)
        install_btn.set_label("Installing...")
        self.log_scroll.set_visible(True)
        self._log_append("Starting setup, please wait...")

        def worker():
            try:
                proc = subprocess.Popen(
                    ["pkexec", f"/usr/libexec/rakuos/{script}"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True
                )
                for line in proc.stdout:
                    line = line.strip()
                    if line:
                        GLib.idle_add(self._log_append, line)
                proc.wait()
                success = proc.returncode == 0
            except Exception as e:
                success = False
                GLib.idle_add(self._log_append, str(e))

            GLib.idle_add(self._on_setup_done, success, install_btn)

        threading.Thread(target=worker, daemon=True).start()

    def _log_append(self, line):
        end = self.log_buffer.get_end_iter()
        self.log_buffer.insert(end, line + "\n")
        # Auto scroll to bottom
        adj = self.log_scroll.get_vadjustment()
        adj.set_value(adj.get_upper())
        return False

    def _on_setup_done(self, success, install_btn):
        if success:
            install_btn.set_label("✓ Done")
            self._log_append("\nSetup completed successfully!")
        else:
            install_btn.set_sensitive(True)
            install_btn.set_label("Retry")
            self._log_append("\nSetup failed. You can retry or skip for now.")
        return False

    # ── Navigation ─────────────────────────────

    def _build_dots(self):
        for child in list(self.dots_box):
            self.dots_box.remove(child)
        self.dot_labels = []
        for i in range(len(self.pages)):
            dot = Gtk.Label(label="●")
            self.dots_box.append(dot)
            self.dot_labels.append(dot)

    def _update_nav(self):
        for i, dot in enumerate(self.dot_labels):
            if i == self.current_page:
                dot.add_css_class("accent")
                dot.remove_css_class("dim-label")
            else:
                dot.add_css_class("dim-label")
                dot.remove_css_class("accent")

        self.back_btn.set_visible(self.current_page > 0)
        last = self.current_page == len(self.pages) - 1
        self.next_btn.set_label("Finish" if last else "Next →")

    def go_next(self, btn):
        if self.current_page == len(self.pages) - 1:
            self._finish()
            return
        self.current_page += 1
        self.stack.set_visible_child_name(self.pages[self.current_page])
        self.log_scroll.set_visible(False)
        self._update_nav()

    def go_back(self, btn):
        if self.current_page > 0:
            self.current_page -= 1
            self.stack.set_visible_child_name(self.pages[self.current_page])
            self.log_scroll.set_visible(False)
            self._update_nav()

    def _finish(self):
        WELCOME_DONE_FILE.parent.mkdir(parents=True, exist_ok=True)
        WELCOME_DONE_FILE.touch()
        self.close()


# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
class WelcomeApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.rakuos.Welcome",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.connect("activate", self.on_activate)

    def on_activate(self, app):
        win = WelcomeWindow(app)
        win.present()


def main():
    if WELCOME_DONE_FILE.exists() and "--force" not in sys.argv:
        sys.exit(0)

    app = WelcomeApp()
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
