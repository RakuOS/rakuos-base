#!/usr/bin/env bash
set -e

echo "Setting up virtualization for RakuOS..."

rakuos install \
    libvirt-daemon-config-network \
    libvirt-daemon-kvm \
    qemu-kvm \
    virt-manager

# Copy polkit rules to /etc so they persist across reboots (overlay is late mount)
echo "Installing polkit rules..."
mkdir -p /etc/polkit-1/actions
cp /usr/share/polkit-1/actions/org.libvirt.*.policy /etc/polkit-1/actions/

# Reload polkit so it picks up the libvirt actions immediately
echo "Reloading polkit..."
systemctl restart polkit

# Add the logged in user to the libvirt group
REAL_USER="${SUDO_USER:-$USER}"
echo "Adding $REAL_USER to libvirt group..."
usermod -aG libvirt "$REAL_USER"

# Enable libvirt
echo "Enabling libvirt service..."
systemctl enable --now libvirtd

echo ""
echo "Virtualization setup complete."
echo "Please reboot to apply group membership and use virt-manager with out password propmt."
