#!/usr/bin/env bash
# generate-base-manifest — Generate list of all files in /usr and base package list
# at image build time. Run at end of Containerfile via RUN command.
set -euo pipefail

MANIFEST_DIR="/usr/share/rakuos"
MANIFEST_FILE="$MANIFEST_DIR/base-manifest.txt"
BASE_PACKAGES_FILE="$MANIFEST_DIR/base-packages.txt"
RAKUOS_DNF_CONF="$MANIFEST_DIR/dnf.conf"

mkdir -p "$MANIFEST_DIR"

echo "Generating RakuOS base file manifest..."

# Full /usr file list
find /usr \( -type f -o -type l \) | sort > "$MANIFEST_FILE"

echo "Collecting files from allowed packages (python3-icoextract, nss*)..."

# Get allowed package names (no arch suffix)
ALLOWED_PKGS=$(rpm --dbpath /usr/lib/sysimage/rpm -qa --qf '%{NAME}\n' \
  | grep -E '^(python3-icoextract|nss.*|nspr.*)$' \
  | sort -u)

# Collect all files owned by those packages
TMP_EXCLUDE_FILES=$(mktemp)

for pkg in $ALLOWED_PKGS; do
  rpm --dbpath /usr/lib/sysimage/rpm -ql "$pkg" 2>/dev/null || true
done | sort -u > "$TMP_EXCLUDE_FILES"

echo "Filtering manifest (removing allowed package files)..."

# Remove those files from manifest
grep -F -v -f "$TMP_EXCLUDE_FILES" "$MANIFEST_FILE" > "${MANIFEST_FILE}.filtered"
mv "${MANIFEST_FILE}.filtered" "$MANIFEST_FILE"

rm -f "$TMP_EXCLUDE_FILES"

TOTAL=$(wc -l < "$MANIFEST_FILE")
echo "Filtered manifest generated: $TOTAL files → $MANIFEST_FILE"

echo "Generating RakuOS base package list..."
# Include arch so x86_64 packages are excluded but i686 (32-bit) equivalents are not
rpm --dbpath /usr/lib/sysimage/rpm -qa --qf '%{NAME}.%{ARCH}\n' \
  | grep -Ev '^(python3-icoextract|nss.*|nspr.*)\.' \
  | sort -u > "$BASE_PACKAGES_FILE"
PKG_TOTAL=$(wc -l < "$BASE_PACKAGES_FILE")
echo "Base package list generated: $PKG_TOTAL packages → $BASE_PACKAGES_FILE"

echo "Writing RakuOS dnf config..."
EXCLUDE_LIST=$(tr '\n' ',' < "$BASE_PACKAGES_FILE" | sed 's/,$//')
printf '[main]\nexcludepkgs=%s\n' "$EXCLUDE_LIST" > "$RAKUOS_DNF_CONF"
echo "RakuOS dnf config written → $RAKUOS_DNF_CONF ($PKG_TOTAL packages excluded)"

echo "RakuOS base manifest generation complete."