#!/usr/bin/env bash
set -e

echo "Checking GPU..."

GPU=$(lspci -nn | grep -E "VGA|3D|Display")

if echo "$GPU" | grep -q "\[1002:"; then
    echo "AMD GPU detected"
    sudo rakuos install rocm

elif echo "$GPU" | grep -q "\[10de:"; then
    echo "NVIDIA GPU detected"
    sudo rakuos install nvidia-driver-cuda nvidia-driver-cuda-libs

else
    echo "No supported GPU detected"
fi

echo "Setting up Ollama..."

TMPDIR=$(mktemp -d)
cd "$TMPDIR"

echo "Downloading and installing Ollama..."
curl -fsSL https://ollama.com/install.sh | sudo sh

cd /
rm -rf "$TMPDIR"

mkdir -p /usr/share/ollama
chown -R ollama:ollama /usr/share/ollama

systemctl restart ollama.service

echo "Ollama setup complete."
