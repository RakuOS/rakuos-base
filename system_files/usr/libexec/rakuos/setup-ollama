#!/usr/bin/env bash
set -e

echo "Checking GPU..."

if lspci -nn | grep -i "VGA\|3D" | grep -qi "AMD\|ATI"; then
    echo "AMD GPU detected. Installing ROCm..."
    rakuos install rocm
else
    echo "No AMD GPU detected. Skipping ROCm install."
fi

echo "Setting up Ollama..."

TMPDIR=$(mktemp -d)
cd "$TMPDIR"

echo "Downloading and installing Ollama..."
curl -fsSL https://ollama.com/install.sh | sudo sh

cd /
rm -rf "$TMPDIR"

echo "Ollama setup complete."