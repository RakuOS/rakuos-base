#!/usr/bin/env bash
# rakuos-pkgroot-init — RakuOS package root initialization.
# Handles first-boot seeding of packages.list and reset requests.
# No overlayfs is used — packages are installed into /var/lib/rakuos/packages.
set -euo pipefail

PACKAGES_LIST="/var/lib/rakuos/packages.list"
DEFAULT_PACKAGES_LIST="/usr/share/rakuos/packages.list"
INSTALLROOT="/var/lib/rakuos/packages"
PKG_CACHE_DIR="/var/lib/rakuos/pkgcache"
PKGROOT_TRACK="/var/lib/rakuos/pkgroot-packages.txt"
STATE_FILE="/var/lib/rakuos/overlay.state"
DIRTY_FILE="/var/lib/rakuos/overlay.dirty"
RESET_MARKER="/var/lib/rakuos/overlay.reset"

# ── Reset requested on last boot ──────────────────────────────────────────────
if [[ -f "$RESET_MARKER" ]]; then
    echo "RakuOS: reset marker found — wiping package installroot..."

    # Wipe installroot, cache, and all state — everything gets rebuilt fresh
    rm -rf "${INSTALLROOT:?}"
    rm -rf "${PKG_CACHE_DIR:?}"
    rm -f "$STATE_FILE" "$PACKAGES_LIST" "$PKGROOT_TRACK" "$DIRTY_FILE"

    rm -f "$RESET_MARKER"
    echo "RakuOS: reset complete. Starting with clean base."
    # Fall through — seed packages.list so sync handles install on next step
fi

# ── Seed packages.list from image default if missing ─────────────────────────
mkdir -p "$(dirname "$PACKAGES_LIST")"

if [[ ! -f "$PACKAGES_LIST" ]]; then
    if [[ -f "$DEFAULT_PACKAGES_LIST" ]]; then
        echo "RakuOS: seeding packages.list from $DEFAULT_PACKAGES_LIST ..."
        cp "$DEFAULT_PACKAGES_LIST" "$PACKAGES_LIST"
        sed -i -e '$a\' "$PACKAGES_LIST"
        touch "$DIRTY_FILE"
        echo "RakuOS: dirty flag set — sync will install seeded packages."
    else
        echo "RakuOS: no default packages.list found — starting empty."
        touch "$PACKAGES_LIST"
    fi
fi

echo "RakuOS: package root init done."
