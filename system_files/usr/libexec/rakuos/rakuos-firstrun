#!/bin/bash
set -e

RAKUOS_SHARE=/usr/share/rakuos
FIRSTRUN_FLAG="$HOME/.config/rakuos/.firstrun-done"

# Firefox search policy
mkdir -p "$HOME/.var/app/org.mozilla.firefox/config/mozilla/firefox/distribution"
cp "$RAKUOS_SHARE/setup/firefox/policies.json" \
   "$HOME/.var/app/org.mozilla.firefox/config/mozilla/firefox/distribution/policies.json"

# Any other first-run setup here
# cp dotfiles, set defaults, etc.

# Mark as done so service never runs again
mkdir -p "$HOME/.config/rakuos"
touch "$FIRSTRUN_FLAG"