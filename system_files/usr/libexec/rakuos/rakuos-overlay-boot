#!/usr/bin/env bash
set -euo pipefail

PACKAGES_LIST="/var/lib/rakuos/packages.list"
OVERLAY_DIR="/var/lib/rakuos/overlay"
UPPER_DIR="$OVERLAY_DIR/upper"
WORK_DIR="$OVERLAY_DIR/work"
STATE_FILE="/var/lib/rakuos/overlay.state"
DIRTY_FILE="/var/lib/rakuos/overlay.dirty"

# Nothing to do if no packages list or it's empty
if [[ ! -f "$PACKAGES_LIST" ]] || [[ ! -s "$PACKAGES_LIST" ]]; then
    echo "No RakuOS overlay packages configured — skipping."
    exit 0
fi

# Read packages into array, skip empty lines
mapfile -t PACKAGES < <(grep -v '^\s*$' "$PACKAGES_LIST")

if [[ "${#PACKAGES[@]}" -eq 0 ]]; then
    echo "No packages in list — skipping."
    exit 0
fi

# Ensure overlay dirs exist
mkdir -p "$UPPER_DIR" "$WORK_DIR"

# Get current booted image digest
CURRENT_DIGEST=$(bootc status --json | jq -r '.status.booted.image.imageDigest // empty')

if [[ -z "$CURRENT_DIGEST" ]]; then
    echo "WARNING: Could not detect current image digest — using unknown."
    CURRENT_DIGEST="unknown"
fi

# Read saved digest
SAVED_DIGEST=$(cat "$STATE_FILE" 2>/dev/null || echo "")

# Check if upper dir has content
OVERLAY_HAS_CONTENT=false
if [[ -n "$(ls -A "$UPPER_DIR" 2>/dev/null)" ]]; then
    OVERLAY_HAS_CONTENT=true
fi

# -------------------------------
# Mount our persistent overlay
# -------------------------------
mount_overlay() {
    mount -t overlay overlay \
        -o lowerdir=/usr,upperdir="$UPPER_DIR",workdir="$WORK_DIR" \
        /usr
}

if ! findmnt /usr | grep -q overlay; then
    echo "RakuOS overlay: mounting persistent overlay..."
    mount_overlay
fi

# -------------------------------
# Decide what action is needed
# -------------------------------

if [[ "$OVERLAY_HAS_CONTENT" == "false" ]]; then
    # Overlay was wiped or first run — full install from package list
    echo "RakuOS overlay: overlay is empty — performing full install..."
    dnf5.real install -y "${PACKAGES[@]}"
    echo "$CURRENT_DIGEST" > "$STATE_FILE"
    rm -f "$DIRTY_FILE"
    echo "RakuOS overlay: full install complete."

elif [[ "$CURRENT_DIGEST" != "$SAVED_DIGEST" ]]; then
    # Image was updated — upgrade packages in place, no wipe
    echo "RakuOS overlay: image updated — upgrading overlay packages..."
    dnf5.real upgrade -y "${PACKAGES[@]}"
    echo "$CURRENT_DIGEST" > "$STATE_FILE"
    rm -f "$DIRTY_FILE"
    echo "RakuOS overlay: package upgrade complete."

elif [[ -f "$DIRTY_FILE" ]]; then
    # Packages were added or removed — reinstall list to sync
    echo "RakuOS overlay: package changes detected — syncing..."
    dnf5.real install -y "${PACKAGES[@]}"
    rm -f "$DIRTY_FILE"
    echo "RakuOS overlay: sync complete."

else
    # Nothing changed — overlay already mounted, nothing to do
    echo "RakuOS overlay: up to date, nothing to do."
fi

# Save digest if not already saved
if [[ -z "$SAVED_DIGEST" ]] || [[ "$CURRENT_DIGEST" != "$SAVED_DIGEST" ]]; then
    echo "$CURRENT_DIGEST" > "$STATE_FILE"
fi

# -------------------------------
# Post-install service activation
# -------------------------------

# Virtualization — enable libvirtd if virt packages are present
VIRT_PACKAGES=(libvirt-daemon-config-network libvirt-daemon-kvm qemu-kvm virt-manager)
for pkg in "${VIRT_PACKAGES[@]}"; do
    if grep -qx "$pkg" "$PACKAGES_LIST"; then
        echo "RakuOS overlay: virtualization packages detected — enabling libvirtd..."
        systemctl enable --now libvirtd || true
        break
    fi
done

echo "RakuOS overlay boot: done."
