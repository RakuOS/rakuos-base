# ─────────────────────────────────────────────
# Main Window
# ─────────────────────────────────────────────
class WelcomeWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Welcome to RakuOS")
        self.setMinimumSize(720, 560)

        ICON_SVG = "/usr/share/pixmaps/rakuos-logo.svg"
        ICON_FALLBACK = "/usr/share/pixmaps/rakuos-logo.png"
        icon_path = ICON_SVG if os.path.exists(ICON_SVG) else ICON_FALLBACK
        if os.path.exists(icon_path):
            self.setWindowIcon(QIcon(icon_path))

        central = QWidget()
        self.setCentralWidget(central)
        main_layout = QVBoxLayout(central)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)

        # Stacked pages
        self.stack = QStackedWidget()
        logo_path = get_logo_path(QApplication.instance())
        self.pages = [
            WelcomePage(logo_path),
            SetupPage(
                "Gaming Setup",
                "Install Steam and Lutris natively for the best gaming performance. "
                "Native packages give better Proton and Wine compatibility than Flatpak.",
                "🎮", "setup-gaming"
            ),
            SetupPage(
                "Virtualization",
                "Set up KVM/QEMU and virt-manager to run virtual machines. "
                "Ideal for running Windows or other Linux distros alongside RakuOS.",
                "🖥️", "setup-virtualization"
            ),
            SetupPage(
                "Local AI with Ollama",
                "Install Ollama to run AI language models locally on your GPU. "
                "Keep your conversations private and use AI without the cloud.",
                "🤖", "setup-ollama"
            ),
            DonePage(),
        ]

        for page in self.pages:
            self.stack.addWidget(page)
            # Connect setup page signals to main window log
            if isinstance(page, SetupPage):
                page.log_output.connect(self.handle_log)

        main_layout.addWidget(self.stack)

        # ── Shared log — lives in main window, below stack, above nav ──
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setFixedHeight(150)
        self.log.setFont(QFont("monospace", 9))
        self.log.setVisible(False)
        main_layout.addWidget(self.log)

        # ── Navigation bar ──
        nav_frame = QFrame()
        nav_frame.setFrameShape(QFrame.Shape.StyledPanel)
        nav_frame.setFixedHeight(64)
        nav_layout = QHBoxLayout(nav_frame)
        nav_layout.setContentsMargins(24, 0, 24, 0)

        self.dots_layout = QHBoxLayout()
        self.dots_layout.setSpacing(8)
        self.dots = []
        for i in range(len(self.pages)):
            dot = QLabel("●")
            self.dots.append(dot)
            self.dots_layout.addWidget(dot)

        nav_layout.addLayout(self.dots_layout)
        nav_layout.addStretch()

        self.back_btn = QPushButton("← Back")
        self.back_btn.setMinimumHeight(36)
        self.back_btn.setMinimumWidth(100)
        self.back_btn.clicked.connect(self.go_back)
        self.back_btn.setVisible(False)
        nav_layout.addWidget(self.back_btn)

        nav_layout.addSpacing(8)

        self.next_btn = QPushButton("Next →")
        self.next_btn.setMinimumHeight(36)
        self.next_btn.setMinimumWidth(100)
        self.next_btn.clicked.connect(self.go_next)
        nav_layout.addWidget(self.next_btn)

        main_layout.addWidget(nav_frame)

        self.current_page = 0
        self.update_nav()

    def handle_log(self, line):
        if line == "__show__":
            self.log.setVisible(True)
            self.log.clear()
            return
        if line:
            self.log.appendPlainText(line)
            self.log.verticalScrollBar().setValue(
                self.log.verticalScrollBar().maximum()
            )

    def update_nav(self):
        palette = self.palette()
        active_color = palette.highlight().color().name()
        inactive_color = palette.mid().color().name()

        for i, dot in enumerate(self.dots):
            dot.setStyleSheet(
                f"color: {active_color};" if i == self.current_page
                else f"color: {inactive_color};"
            )

        self.back_btn.setVisible(self.current_page > 0)
        self.next_btn.setText(
            "Finish" if self.current_page == len(self.pages) - 1 else "Next →"
        )

    def go_next(self):
        if self.current_page == len(self.pages) - 1:
            self.finish()
            return
        self.current_page += 1
        self.stack.setCurrentIndex(self.current_page)
        # Hide log when navigating away from setup pages
        self.log.setVisible(False)
        self.update_nav()

    def go_back(self):
        if self.current_page > 0:
            self.current_page -= 1
            self.stack.setCurrentIndex(self.current_page)
            self.log.setVisible(False)
            self.update_nav()

    def finish(self):
        WELCOME_DONE_FILE.parent.mkdir(parents=True, exist_ok=True)
        WELCOME_DONE_FILE.touch()
        self.close()


# ─────────────────────────────────────────────
# Entry point
# ─────────────────────────────────────────────
def main():
    if WELCOME_DONE_FILE.exists() and "--force" not in sys.argv:
        sys.exit(0)

    app = QApplication(sys.argv)
    app.setApplicationName("RakuOS Welcome")
    app.setApplicationVersion("1.0")

    window = WelcomeWindow()
    window.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
