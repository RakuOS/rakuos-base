# ─────────────────────────────────────────────
# Generic setup page — no log here, log lives in main window
# ─────────────────────────────────────────────
class SetupPage(QWidget):
    # Signal to tell main window to show/append to log
    log_output = pyqtSignal(str)
    setup_done = pyqtSignal(bool)

    def __init__(self, title, description, icon, script, parent=None):
        super().__init__(parent)
        self.script = script
        self.worker = None

        layout = QVBoxLayout(self)
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.setSpacing(16)
        layout.setContentsMargins(60, 40, 60, 40)

        icon_label = QLabel(icon)
        icon_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        font = QFont()
        font.setPointSize(52)
        icon_label.setFont(font)
        layout.addWidget(icon_label)

        title_label = QLabel(title)
        title_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        font2 = QFont()
        font2.setPointSize(18)
        font2.setBold(True)
        title_label.setFont(font2)
        layout.addWidget(title_label)

        desc_label = QLabel(description)
        desc_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        desc_label.setWordWrap(True)
        desc_label.setMaximumWidth(560)
        layout.addWidget(desc_label, alignment=Qt.AlignmentFlag.AlignCenter)

        layout.addSpacing(10)

        self.install_btn = QPushButton(f"Set Up {title}")
        self.install_btn.setMinimumHeight(42)
        self.install_btn.setMinimumWidth(180)
        self.install_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self.install_btn.clicked.connect(self.run_setup)
        layout.addWidget(self.install_btn, alignment=Qt.AlignmentFlag.AlignCenter)

        layout.addStretch()

    def run_setup(self):
        self.install_btn.setEnabled(False)
        self.install_btn.setText("Installing...")
        self.log_output.emit("__show__")
        self.log_output.emit("Starting setup, please wait...")

        self.worker = SetupWorker(self.script)
        self.worker.output.connect(lambda line: self.log_output.emit(line))
        self.worker.finished.connect(self.on_finished)
        self.worker.start()

    def on_finished(self, success, script):
        self.setup_done.emit(success)
        if success:
            self.install_btn.setText("✓ Done")
            self.log_output.emit("\nSetup completed successfully!")
        else:
            self.install_btn.setEnabled(True)
            self.install_btn.setText("Retry")
            self.log_output.emit("\nSetup failed. You can retry or skip for now.")


