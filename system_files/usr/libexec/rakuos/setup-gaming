#!/usr/bin/env bash
set -euo pipefail

echo "Setting up gaming for RakuOS..."

rakuos install \
    steam \
    lutris \
    heroic-games-launcher \
    lact \
    goverlay \
    mangohud \
    mangohud.i686 \
    protonplus \
    protontricks \
    vkBasalt \
    vkBasalt.i686 \
    steam-devices

systemctl enable --now lactd

echo ""
echo "Gaming setup complete!"