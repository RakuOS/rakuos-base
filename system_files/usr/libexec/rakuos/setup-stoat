#!/bin/bash
set -e

STOAT_VERSION="1.3.0"
STOAT_ZIP="Stoat-linux-x64-${STOAT_VERSION}.zip"
STOAT_URL="https://github.com/stoatchat/for-desktop/releases/download/v${STOAT_VERSION}/${STOAT_ZIP}"

EXTRACTED_DIR="/opt/Stoat-linux-x64"
FINAL_DIR="/opt/stoat"

BIN_LINK="/usr/local/bin/stoat"
DESKTOP_FILE="/usr/local/share/applications/stoat.desktop"
ICON_PATH="/usr/local/share/icons/stoat.png"

TMP_ZIP="/tmp/${STOAT_ZIP}"

# Download
if [ ! -f "$TMP_ZIP" ]; then
    echo "Downloading Stoat..."
    wget -q "$STOAT_URL" -O "$TMP_ZIP"
fi

# Install cleanly
if [ ! -d "$FINAL_DIR" ]; then
    echo "Installing Stoat..."

    rm -rf "$EXTRACTED_DIR"

    cd /opt
    unzip -q -o "$TMP_ZIP"

    mv "$EXTRACTED_DIR" "$FINAL_DIR"

    chmod -R a+r "$FINAL_DIR"
    chmod a+x "$FINAL_DIR/stoat-desktop"
fi

# Always update symlink
ln -sf "$FINAL_DIR/stoat-desktop" "$BIN_LINK"

# Icon
if [ ! -f "$ICON_PATH" ]; then
    wget -q https://raw.githubusercontent.com/stoatchat/assets/refs/heads/main/desktop/icon.png -O "$ICON_PATH"
fi

# Desktop file
mkdir -p "$(dirname "$DESKTOP_FILE")"
cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Name=Stoat
Comment=Stoat Chat Client
Exec=$BIN_LINK
Icon=$ICON_PATH
Terminal=false
Type=Application
Categories=Network;Chat;
EOF

echo "Stoat installation complete."