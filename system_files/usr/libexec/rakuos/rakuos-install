#!/usr/bin/env bash
set -euo pipefail

PACKAGES=("${@}")
PACKAGES_LIST="/var/lib/rakuos/packages.list"

if [[ "${#PACKAGES[@]}" -eq 0 ]]; then
    echo "Usage: rakuos install <package> [package2] [package3]..."
    exit 1
fi

# Must run as root
if [[ "$EUID" -ne 0 ]]; then
    echo "ERROR: rakuos install must be run as root"
    exit 1
fi

# Ensure packages list dir exists
mkdir -p /var/lib/rakuos

# Filter out already installed packages
TO_INSTALL=()
for pkg in "${PACKAGES[@]}"; do
    if grep -qx "$pkg" "$PACKAGES_LIST" 2>/dev/null; then
        echo "$pkg is already installed via RakuOS overlay — skipping."
    else
        TO_INSTALL+=("$pkg")
    fi
done

if [[ "${#TO_INSTALL[@]}" -eq 0 ]]; then
    echo "All requested packages already installed."
    exit 0
fi

echo "Installing ${TO_INSTALL[*]} via bootc usr-overlay..."

# Mount overlay if not already active
if ! findmnt /usr | grep -q overlay; then
    echo "Mounting bootc usr-overlay..."
    bootc usr-overlay
fi

# Install packages into overlay
echo "Running dnf5.real install ${TO_INSTALL[*]}..."
dnf5.real install -y "${TO_INSTALL[@]}"

# Add each to packages list
for pkg in "${TO_INSTALL[@]}"; do
    echo "$pkg" >> "$PACKAGES_LIST"
done

echo "${TO_INSTALL[*]} installed successfully and added to RakuOS package list."
