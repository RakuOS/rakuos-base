#!/usr/bin/env bash
# rakuos-pkgroot-generator — systemd generator for RakuOS package installroot.
#
# Runs early at boot (and on every daemon-reload) to:
#   1. Symlink installroot unit files into systemd's generator search path.
#   2. Wire up WantedBy= targets so enabled services start with their target.
#   3. Write drop-in overrides that rewrite hardcoded /usr/ exec paths to
#      their installroot equivalents — but only for paths that actually exist
#      in the installroot (base system binaries like /usr/bin/systemctl are
#      left untouched).
#
# systemd passes three directories:
#   $1 = early, $2 = normal (used here), $3 = late

INSTALLROOT="/var/lib/rakuos/packages"
PKGROOT_UNITS="$INSTALLROOT/usr/lib/systemd/system"
GENERATOR_DIR="${2:-/run/systemd/generator}"

[[ -d "$PKGROOT_UNITS" ]] || exit 0

mkdir -p "$GENERATOR_DIR"

# ── Helpers ───────────────────────────────────────────────────────────────────

# Rewrite a single Exec*= value if its binary exists in the installroot.
# Preserves leading modifiers (-, @, !, +, !! etc.) before the path.
# Prints the (possibly rewritten) value.
_rewrite_exec_value() {
    local value="$1"
    local mods="" rest="$value"

    # Strip leading modifiers: -, @, !, +, and combinations like -! !!
    if [[ "$rest" =~ ^([-@!+]+)(/usr/) ]]; then
        mods="${BASH_REMATCH[1]}"
        rest="${rest#$mods}"
    fi

    if [[ "$rest" == /usr/* ]]; then
        # Isolate the binary path (everything before the first space)
        local bin_path="${rest%% *}"
        local installroot_bin="${INSTALLROOT}${bin_path}"

        if [[ -f "$installroot_bin" || -L "$installroot_bin" ]]; then
            echo "${mods}${INSTALLROOT}${rest}"
            return
        fi
    fi

    # Not an installroot path — return unchanged
    echo "$value"
}

# Write a drop-in that rewrites Exec* directives whose binaries live in
# the installroot.  Returns 0 if a drop-in was written, 1 if not needed.
_write_path_dropin() {
    local unit_file="$1"
    local unit="$2"

    # Collect all Exec* lines from the unit file
    local exec_lines
    mapfile -t exec_lines < <(grep -E "^(Exec[A-Za-z]*)=" "$unit_file" 2>/dev/null)
    [[ "${#exec_lines[@]}" -eq 0 ]] && return 1

    # Check if any Exec* value needs rewriting before we create any files
    local needs_dropin=false
    for line in "${exec_lines[@]}"; do
        local value="${line#*=}"
        local rewritten
        rewritten=$(_rewrite_exec_value "$value")
        if [[ "$rewritten" != "$value" ]]; then
            needs_dropin=true
            break
        fi
    done
    "$needs_dropin" || return 1

    local dropin_dir="$GENERATOR_DIR/${unit}.d"
    mkdir -p "$dropin_dir"
    local dropin="$dropin_dir/10-rakuos-installroot.conf"

    {
        echo "[Service]"

        # Track which directives have been cleared to handle list-type
        # directives (e.g. multiple ExecStart= in Type=oneshot correctly)
        declare -A cleared=()

        for line in "${exec_lines[@]}"; do
            local directive="${line%%=*}"
            local value="${line#*=}"

            # Emit one clear line per directive to reset any existing list
            if [[ -z "${cleared[$directive]+set}" ]]; then
                echo "${directive}="
                cleared[$directive]=1
            fi

            echo "${directive}=$(_rewrite_exec_value "$value")"
        done
    } > "$dropin"

    return 0
}

# ── Main ──────────────────────────────────────────────────────────────────────

for unit_file in "$PKGROOT_UNITS"/*.service \
                 "$PKGROOT_UNITS"/*.socket \
                 "$PKGROOT_UNITS"/*.timer \
                 "$PKGROOT_UNITS"/*.target \
                 "$PKGROOT_UNITS"/*.path; do
    [[ -f "$unit_file" ]] || continue
    unit=$(basename "$unit_file")

    # Skip template units
    [[ "$unit" == *@* ]] && continue

    # Symlink unit file into the generator directory
    ln -sf "$unit_file" "$GENERATOR_DIR/$unit"

    # Wire up WantedBy= so enabled services start automatically with their target
    wanted_by=$(grep -m1 '^WantedBy=' "$unit_file" 2>/dev/null | cut -d= -f2-)
    if [[ -n "$wanted_by" ]]; then
        for target in $wanted_by; do
            wants_dir="$GENERATOR_DIR/${target}.wants"
            mkdir -p "$wants_dir"
            ln -sf "$unit_file" "$wants_dir/$unit"
        done
    fi

    # Write path-rewrite drop-in if any Exec* binary lives in the installroot
    _write_path_dropin "$unit_file" "$unit"
done
