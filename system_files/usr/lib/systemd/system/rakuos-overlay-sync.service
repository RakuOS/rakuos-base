[Unit]
Description=RakuOS Overlay Sync
Documentation=https://rakuos.org
After=network-online.target systemd-resolved.service rakuos-overlay-mount.service
Wants=network-online.target systemd-resolved.service
ConditionPathExists=/var/lib/rakuos/packages.list

[Service]
Type=oneshot
ExecStartPre=/bin/bash -c 'until nslookup mirrors.fedoraproject.org >/dev/null 2>&1; do echo "Waiting for DNS..."; sleep 2; done'
ExecStart=/usr/libexec/rakuos/rakuos-overlay-sync
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target