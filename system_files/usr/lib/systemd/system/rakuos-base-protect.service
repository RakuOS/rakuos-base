[Unit]
Description=RakuOS Base System Protection
Documentation=https://rakuos.org
# Only active when using overlayfs on /usr (legacy mode)
ConditionPathIsDirectory=/var/lib/rakuos/overlay/upper

[Service]
Type=simple
ExecStart=/usr/libexec/rakuos/rakuos-base-protect
Restart=always
RestartSec=5
TimeoutSec=infinity
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
