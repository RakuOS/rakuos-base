#!/usr/bin/env bash
set -e

COMMAND="${1:-}"

case "$COMMAND" in
    update)
        /usr/libexec/rakuos/rakuos-updater
        ;;
    setup-virtualization)
        /usr/libexec/rakuos/setup-virtualization
        ;;
    setup-lsfg-vk)
        /usr/libexec/rakuos/setup-lsfg-vk
        ;;
    setup-ollama)
        /usr/libexec/rakuos/setup-ollama
        ;;
    *)
        echo "RakuOS helper"
        echo ""
        echo "Usage:"
        echo "  rakuos update"
        echo "  rakuos setup-virtualization"
        echo "  rakuos setup-lsfg-vk"
        echo "  rakuos setup-ollama"
        exit 1
        ;;
esac