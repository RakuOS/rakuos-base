#!/usr/bin/env bash
set -e

COMMAND="${1:-}"

case "$COMMAND" in
    install)
        shift
        /usr/libexec/rakuos/rakuos-install "$@"
    ;;
    update)
        shift
        /usr/libexec/rakuos/rakuos-update "$@"
    ;;
    remove)
        shift
        /usr/libexec/rakuos/rakuos-remove "$@"
    ;;
    system-upgrade)
        shift
        /usr/libexec/rakuos/rakuos-updater "$@"
    ;;
    list)
        /usr/libexec/rakuos/rakuos-list
    ;;
    reset-overlay)
        shift
        /usr/libexec/rakuos/rakuos-reset-overlay "$@"
    ;;
    setup-gaming)
        /usr/libexec/rakuos/setup-gaming
    ;;
    setup-virtualization)
        /usr/libexec/rakuos/setup-virtualization
    ;;
    setup-lsfg-vk)
        /usr/libexec/rakuos/setup-lsfg-vk
    ;;
    setup-stoat)
        /usr/libexec/rakuos/setup-stoat
    ;;
    setup-ollama)
        /usr/libexec/rakuos/setup-ollama
    ;;
    *)
        echo "RakuOS Helper"
        echo ""
        echo "Usage:"
        echo "  rakuos install <package> [pkg2...]   Install packages via overlay"
        echo "  rakuos update                        Update packages via overlay"
        echo "  rakuos remove <package> [pkg2...]    Remove packages from overlay"
        echo "  rakuos list                          List overlay installed packages"
        echo "  rakuos system-upgrade                Check for and Apply system image upgrades"
        echo "  rakuos reset-overlay --confirm       Wipe overlay and all installed packages
  rakuos reset-overlay --soft          Soft reset: rebuild overlay, preserve packages.list"
        echo "  rakuos setup-gaming                  Set up native gaming packages along with some apps from flathub"
        echo "  rakuos setup-virtualization          Set up KVM/QEMU virtualization"
        echo "  rakuos setup-lsfg-vk                 Set up Lossless Scaling Frame Gen"
        echo "  rakuos setup-stoat                   Set up Stoat"
        echo "  rakuos setup-ollama                  Set up Ollama local AI"
        exit 1
    ;;
esac
