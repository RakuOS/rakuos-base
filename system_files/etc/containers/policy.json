      ],
      "quay.io": [
        {
          "type": "insecureAcceptAnything"
        }
      ],
      "docker.io": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    },
    "containers-storage": {
      "": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    }
  }
}