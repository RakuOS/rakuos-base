{
  "default": [
    {
      "type": "insecureAcceptAnything"
    }
  ],
  "transports": {
    "docker": {
      "ghcr.io/rakuos": [
        {
          "type": "insecureAcceptAnything"
        }
      ],
      "quay.io/rakuos": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/pki/containers/rakuos-cosign.pub",
          "signedIdentity": {
            "type": "matchRepository"
          }
        }
      ],
      "registry.gitlab.com/rakuos/images": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    },
    "containers-storage": {
      "": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    }
  }
}