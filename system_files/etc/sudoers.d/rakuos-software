# RakuOS Software Center — passwordless sudo for wheel group
# File: /etc/sudoers.d/rakuos

# Initial setup — allow rakuos-setup user to trigger first-boot package install
rakuos-setup ALL=(ALL) NOPASSWD: /usr/libexec/rakuos/rakuos-overlay-sync --initial-install

# Package management
%wheel ALL=(ALL) NOPASSWD: /usr/libexec/rakuos/rakuos-install
%wheel ALL=(ALL) NOPASSWD: /usr/libexec/rakuos/rakuos-remove
%wheel ALL=(ALL) NOPASSWD: /usr/libexec/rakuos/rakuos-update

# Flatpak system-wide operations
%wheel ALL=(ALL) NOPASSWD: /usr/bin/flatpak install --bundle --noninteractive -y *
%wheel ALL=(ALL) NOPASSWD: /usr/bin/flatpak install --from --noninteractive -y *

# bootc image operations
%wheel ALL=(ALL) NOPASSWD: /usr/bin/bootc status --json
%wheel ALL=(ALL) NOPASSWD: /usr/bin/bootc upgrade --check
%wheel ALL=(ALL) NOPASSWD: /usr/bin/bootc upgrade
%wheel ALL=(ALL) NOPASSWD: /usr/bin/bootc switch *
%wheel ALL=(ALL) NOPASSWD: /usr/bin/bootc rollback
%wheel ALL=(ALL) NOPASSWD: /usr/bin/bootc install *

# Detached bootc image operations via systemd one-shot units.
# Exact argument match — no wildcards — so ONLY these two units can be started
# without a password. Any other unit name or systemctl subcommand requires auth.
%wheel ALL=(ALL) NOPASSWD: /usr/bin/systemctl start rakuos-bootc-upgrade.service
%wheel ALL=(ALL) NOPASSWD: /usr/bin/systemctl start rakuos-bootc-switch.service
%wheel ALL=(ALL) NOPASSWD: /usr/bin/systemctl reset-failed rakuos-bootc-upgrade.service
%wheel ALL=(ALL) NOPASSWD: /usr/bin/systemctl reset-failed rakuos-bootc-switch.service
%wheel ALL=(ALL) NOPASSWD: /usr/bin/tee /run/rakuos/bootc-switch-target
