# Adapted from CoreOS coreos-update-ca-trust.service
# https://github.com/coreos/fedora-coreos-config/blob/8ab99b12/overlay.d/05core/usr/lib/systemd/system/coreos-update-ca-trust.service
#
# On bootc/ostree systems, files generated by update-ca-trust in /etc
# may become stale after an image upgrade. The 3-way merge preserves
# locally modified generated files, so new CA additions or removals
# from the updated image are not reflected until regeneration.
# See: https://forge.fedoraproject.org/atomic/tracker/issues/145
[Unit]
Description=Regenerate CA certificate trust store
Documentation=https://forge.fedoraproject.org/atomic/tracker/issues/145
# Only run on bootc/ostree deployed systems, not in containers.
ConditionPathIsMountPoint=/sysroot
# Only run if the update tool is available.
ConditionPathExists=/usr/bin/update-ca-trust
# Only run when /etc may be stale relative to /usr: on first boot and on the
# first boot after a new deployment, when ostree removes /etc/.updated. Local
# edits to the trust sources still require running update-ca-trust by hand,
# as on any other system. This keeps the cost off the boot path otherwise.
ConditionNeedsUpdate=/etc
# Fedora CoreOS ships coreos-update-ca-trust.service, which runs the same
# command on first boot. update-ca-trust does not lock its output, so running
# both concurrently is unsafe. Yield to the CoreOS unit when it is present;
# drop this condition once CoreOS rebases on this image.
ConditionPathExists=!/usr/lib/systemd/system/coreos-update-ca-trust.service
# Refresh before services with normal startup dependencies. This does not
# refresh trust embedded in the initramfs or trust already loaded by earlier
# consumers.
DefaultDependencies=no
Requires=local-fs.target
After=local-fs.target
Before=sysinit.target
# Units using ConditionNeedsUpdate= must run before systemd-update-done.service
# touches /etc/.updated, which would make the condition false if it ran first.
Before=systemd-update-done.service
# systemd-resolved also uses DefaultDependencies=no and orders itself before
# sysinit.target, so without an explicit ordering it can start in parallel
# with regeneration and read a stale trust store for DNS-over-TLS. Order
# before it; systemd ignores this when the unit is not installed.
Before=systemd-resolved.service

[Service]
Type=oneshot
RemainAfterExit=yes
# sysinit.target wants this service: failure is reported in the journal
# and as a failed unit, but does not prevent the rest of the system booting.
ExecStart=/usr/bin/update-ca-trust
